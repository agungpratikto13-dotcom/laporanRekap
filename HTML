<!DOCTYPE html>
<html lang="id">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Laporan Harian</title>

<style>
    body {
        font-family: Arial, sans-serif;
        background: #f2f4f7;
        margin: 0;
        padding: 20px;
        color: #222;
    }

    .container {
        max-width: 1000px;
        margin: auto;
        background: white;
        padding: 25px;
        border-radius: 12px;
        box-shadow: 0 3px 15px rgba(0,0,0,0.10);
    }

    h1 {
        text-align: center;
        margin-bottom: 25px;
        font-size: 24px;
    }

    h2 {
        background: #222;
        color: white;
        padding: 10px;
        font-size: 17px;
        border-radius: 6px;
        margin-top: 25px;
    }

    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 10px;
    }

    th {
        background: #e9ecef;
        font-weight: bold;
    }

    th, td {
        border: 1px solid #ccc;
        padding: 10px;
    }

    td input {
        width: 100%;
        box-sizing: border-box;
        border: none;
        outline: none;
        font-size: 14px;
        background: transparent;
    }

    td input:focus {
        background: #fff8dc;
    }

    .angka {
        text-align: right;
    }

    .total {
        font-weight: bold;
        background: #dff0d8;
    }

    .rekap-total {
        background: #b7e4c7;
        font-weight: bold;
        font-size: 16px;
    }

    .buttons {
        display: flex;
        gap: 10px;
        margin-top: 25px;
        flex-wrap: wrap;
    }

    button {
        border: none;
        padding: 12px 18px;
        border-radius: 6px;
        cursor: pointer;
        font-weight: bold;
    }

    .copy {
        background: #198754;
        color: white;
    }

    .reset {
        background: #dc3545;
        color: white;
    }

    .add {
        background: #0d6efd;
        color: white;
    }

    button:hover {
        opacity: 0.85;
    }

    @media(max-width:600px) {
        body {
            padding: 8px;
        }

        .container {
            padding: 12px;
        }

        table {
            font-size: 12px;
        }

        th, td {
            padding: 6px;
        }
    }
</style>
</head>

<body>

<div class="container">

<h1>LAPORAN HARIAN</h1>

<h2>TRANSAKSI PGA & QRIS</h2>

<table id="transaksi">
    <thead>
        <tr>
            <th>JENIS</th>
            <th>TANGGAL</th>
            <th>TOTAL</th>
            <th>TRX</th>
        </tr>
    </thead>

    <tbody>
        <tr>
            <td>DEPO PGA</td>
            <td><input value="27 AGUSTUS 2026"></td>
            <td>
                <input class="angka uang" value="897304127"
                       oninput="formatInput(this)">
            </td>
            <td>
                <input class="angka trx" value="8661"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>WD PGA</td>
            <td><input value="27 AGUSTUS 2026"></td>
            <td>
                <input class="angka uang" value="295900000"
                       oninput="formatInput(this)">
            </td>
            <td>
                <input class="angka trx" value="63"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>PENCAIRAN DANA PGA</td>
            <td><input value="27 AGUSTUS 2026"></td>
            <td>
                <input class="angka uang" value="550000000"
                       oninput="formatInput(this)">
            </td>
            <td>
                <input class="angka trx" value="22"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>DEPO QRIS PAYDIA (PRN)</td>
            <td><input value="26 AGUSTUS 2026"></td>
            <td>
                <input class="angka uang" value="1412498440"
                       oninput="formatInput(this)">
            </td>
            <td>
                <input class="angka trx" value="25052"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>DEPO QRIS NETZME</td>
            <td><input value="26 AGUSTUS 2026"></td>
            <td>
                <input class="angka uang" value="114271189"
                       oninput="formatInput(this)">
            </td>
            <td>
                <input class="angka trx" value="2084"
                       oninput="formatInput(this)">
            </td>
        </tr>
    </tbody>
</table>


<h2>REKAP</h2>

<table>
    <tbody>

        <tr>
            <td>MEMBER AKTIF</td>
            <td>
                <input class="angka" value="23842"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>TURNOVER</td>
            <td>
                <input class="angka uang" value="15003387115"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>REPORT DEPO</td>
            <td>
                <input class="angka uang" value="2621550933"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>REPORT WD</td>
            <td>
                <input class="angka uang" value="2104663396"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>REGIS</td>
            <td>
                <input class="angka" value="884"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>REG DEPO</td>
            <td>
                <input class="angka" value="683"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>TRX DEPO</td>
            <td>
                <input id="trxDepo" class="angka"
                       value="39049"
                       oninput="hitungTotalTrx(this)">
            </td>
        </tr>

        <tr>
            <td>TRX WD</td>
            <td>
                <input id="trxWd" class="angka"
                       value="6596"
                       oninput="hitungTotalTrx(this)">
            </td>
        </tr>

        <tr class="rekap-total">
            <td>TOTAL TRX</td>
            <td>
                <input id="totalTrx"
                       class="angka"
                       value="45645"
                       readonly>
            </td>
        </tr>

    </tbody>
</table>


<h2>BONUS & CASHBACK</h2>

<table>
    <tbody>

        <tr>
            <td>BONUS HARIAN</td>
            <td>
                <input class="angka uang"
                       value="1563400"
                       oninput="formatInput(this)">
            </td>
        </tr>

        <tr>
            <td>CASHBACK LIVE GAME</td>
            <td>
                <input value="17 AGUSTUS 2026 s/d 23 AGUSTUS 2026">
            </td>
        </tr>

        <tr>
            <td>TOTAL CASHBACK</td>
            <td>
                <input class="angka uang"
                       value="16543103"
                       oninput="formatInput(this)">
            </td>
        </tr>

    </tbody>
</table>


<div class="buttons">
    <button class="copy" onclick="copyLaporan()">
        📋 COPY LAPORAN
    </button>

    <button class="reset" onclick="resetLaporan()">
        🔄 RESET
    </button>
</div>

</div>


<script>

function angkaBersih(value) {
    return value.replace(/,/g, '').replace(/\D/g, '');
}


function formatInput(input) {

    let value = angkaBersih(input.value);

    if (value === '') {
        input.value = '';
        return;
    }

    input.value = Number(value).toLocaleString('en-US');

    if (input.id === 'trxDepo' || input.id === 'trxWd') {
        hitungTotalTrx();
    }
}


function hitungTotalTrx() {

    let depo = angkaBersih(
        document.getElementById('trxDepo').value
    );

    let wd = angkaBersih(
        document.getElementById('trxWd').value
    );

    depo = Number(depo || 0);
    wd = Number(wd || 0);

    let total = depo + wd;

    document.getElementById('totalTrx').value =
        total.toLocaleString('en-US');
}


function copyLaporan() {

    let teks = '';

    teks += 'LAPORAN HARIAN\n';
    teks += '===============================\n\n';

    let rows = document.querySelectorAll('#transaksi tbody tr');

    rows.forEach(row => {

        let kolom = row.querySelectorAll('td');

        let jenis = kolom[0].innerText.trim();
        let tanggal = kolom[1].querySelector('input').value;
        let total = kolom[2].querySelector('input').value;
        let trx = kolom[3].querySelector('input').value;

        teks += jenis + ' TANGGAL ' + tanggal + '\n';
        teks += 'TOTAL     = ' + total + '\n';
        teks += 'TRX       = ' + trx + '\n\n';
    });


    teks += 'REKAP\n';
    teks += '===============================\n';

    let rekap = document.querySelectorAll(
        '.container > table:not(#transaksi) tbody tr'
    );

    rekap.forEach(row => {

        let kolom = row.querySelectorAll('td');

        if (kolom.length < 2) return;

        let nama = kolom[0].innerText.trim();
        let input = kolom[1].querySelector('input');

        if (input) {
            teks += nama + ' : ' + input.value + '\n';
        }
    });


    navigator.clipboard.writeText(teks)
        .then(() => {
            alert('Laporan berhasil di-copy!');
        });
}


function resetLaporan() {

    if (confirm('Yakin ingin mengembalikan data awal?')) {
        location.reload();
    }
}


// Format angka saat halaman pertama dibuka
document.querySelectorAll('.angka').forEach(input => {
    if (input.value) {
        let value = angkaBersih(input.value);
        input.value = Number(value).toLocaleString('en-US');
    }
});

</script>

</body>
</html>
